<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="mrp_production_form_view">
        <field name="name">mrp.production.form@mrp_stock_actions</field>
        <field name="model">mrp.production</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="priority" eval="50" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/list" position="inside">
                <button
                    name="action_reassign"
                    title="Unreserve all and re-check availability"
                    type="object"
                    icon="fa-bar-chart-o"
                    invisible="is_locked or not action_reassign_visible"
                />
                <!-- Note: context overrides `default_state` set from  -->
                <button
                    name="action_set_mto"
                    title="Change procure method to « Make to Order » and make a restock order (buy, manufacture)"
                    type="object"
                    confirm="Are you sure you want to change procure method of this move?"
                    icon="fa-gear"
                    invisible="is_locked or not action_set_mto_visible"
                />
                <button
                    name="action_cancel"
                    title="Cancel"
                    type="object"
                    confirm="Are you sure you want to cancel this move?"
                    column_invisible="parent.is_locked"
                    invisible="not is_cancellable"
                    icon="fa-ban"
                />
            </xpath>
        </field>
    </record>
</odoo>
