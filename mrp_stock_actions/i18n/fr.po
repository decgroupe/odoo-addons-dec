msgid "Are you sure you want to cancel this move?"
msgstr "Êtes-vous sûr de vouloir annuler ce mouvement ?"

#. module: mrp_stock_actions
#: model_terms:ir.ui.view,arch_db:mrp_stock_actions.mrp_production_form_view
msgid "Are you sure you want to change procure method of this move?"
msgstr ""
"Êtes-vous sûr de vouloir modifier le mode d'approvisionnement de ce "
"transfert ?"

#. module: mrp_stock_actions
#: model_terms:ir.ui.view,arch_db:mrp_stock_actions.mrp_production_form_view
