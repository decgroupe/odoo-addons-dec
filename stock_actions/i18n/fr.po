#. module: stock_actions
#: model_terms:ir.ui.view,arch_db:stock_actions.picking_action_cancel_form_view
msgid "Are you sure you want to cancel this move?"
msgstr "Êtes-vous sûr de vouloir annuler ce mouvement ?"

#. module: stock_actions
#: model_terms:ir.ui.view,arch_db:stock_actions.picking_action_reassign_form_view
msgid "Are you sure you want to change procure method of this move?"
msgstr ""
"Êtes-vous sûr de vouloir modifier le mode d'approvisionnement de ce "
"mouvement ?"

#. module: stock_actions
#: model_terms:ir.ui.view,arch_db:stock_actions.picking_action_cancel_form_view
msgid "Cancel"
msgstr "Annuler"

#. module: stock_actions
#: model_terms:ir.ui.view,arch_db:stock_actions.picking_action_reassign_form_view
msgid ""
"Change procure method to « Make to Order » and make a restock order (buy, "
"manufacture)"
msgstr ""
"Modifier le mode d'approvisionnement en « Sur commande » (MTO) et passer "
"une commande de réapprovisionnement (achat, fabrication)"

#. module: stock_actions
#: model:ir.model.fields,field_description:stock_actions.field_stock_move__is_cancellable
msgid "Is Cancellable"
msgstr "Est annulable"

#. module: stock_actions
#: model:ir.model.fields,field_description:stock_actions.field_stock_move__action_set_mto_visible
msgid "Shows button to convert procure method to MTO"
msgstr ""
"Affiche un bouton permettant de convertir la méthode d'approvisionnement "
"en MTO"

#. module: stock_actions
#: model:ir.model.fields,field_description:stock_actions.field_stock_move__action_reassign_visible
msgid "Shows button to reassign"
msgstr "Affiche le bouton pour revérifier la disponibilité"

#. module: stock_actions
#: model:ir.model,name:stock_actions.model_stock_move
msgid "Stock Move"
msgstr "Mouvement de stock"

#. module: stock_actions
#: model:ir.model.fields,help:stock_actions.field_stock_move__is_cancellable
msgid "Technical field to check for button visibility"
msgstr "Champ technique pour vérifier la visibilité du bouton"

#. module: stock_actions
#: model:ir.model,name:stock_actions.model_stock_picking
msgid "Transfer"
msgstr "Transfert"

#. module: stock_actions
#: model_terms:ir.ui.view,arch_db:stock_actions.picking_action_reassign_form_view
msgid "Unreserve all and re-check availability"
msgstr "Annuler la réservation et revérifier la disponibilité"

