<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.menu" id="menu_pricelist_items">
        <field name="name">Pricelist Items</field>
        <field name="sequence" eval="4" />
        <field
            name="action"
            ref="product_pricelist_analysis.act_window_product_pricelist_item"
        />
        <field name="parent_id" ref="sale.product_menu_catalog" />
        <!-- `group_sale_pricelist` has been removed from Odoo 18.0 -->
        <field
            name="groups_id"
            eval="[Command.set([ref('product.group_product_pricelist')])]"
        />
    </record>
</odoo>
