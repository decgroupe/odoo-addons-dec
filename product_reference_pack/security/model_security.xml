<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="res.groups" id="group_ref_pack_user">
        <field name="name">Pack User</field>
        <field
            name="category_id"
            ref="product_reference_management.module_category_reference"
        />
    </record>

    <record model="res.groups" id="group_ref_pack_manager">
        <field name="name">Pack Manager</field>
        <field
            name="category_id"
            ref="product_reference_management.module_category_reference"
        />
        <field name="implied_ids" eval="[Command.link(ref('group_ref_pack_user'))]" />
        <field
            name="users"
            eval="[
                Command.link(ref('base.user_root')),
                Command.link(ref('base.user_admin'))
            ]"
        />
    </record>
</odoo>
