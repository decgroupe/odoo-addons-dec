<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="mrp_swap_production_form_view">
        <field name="name">mrp.swap.production@mrp_swap_production</field>
        <field name="model">mrp.swap.production</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="">
                <group>
                    <field name="product_id" />
                    <field name="this_production_id" />
                    <field
                        name="other_production_id"
                        domain="[
                            ('id', '!=', this_production_id),
                            ('product_id', '=', product_id),
                            ('state', '!=', 'cancel'),
                        ]"
                    />
                </group>
                <group>
                    <field name="swap_line_ids" />
                </group>
                <footer>
                    <button
                        type="object"
                        name="do_swap"
                        string="Confirm"
                        class="btn-primary"
                        context="{}"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_window_swap_production">
        <field name="name">🧙‍♂️ Swap this manufacturing order ...</field>
        <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="binding_view_types">form</field>
        <field name="context">{'default_this_production_id': active_id}</field>
        <field name="res_model">mrp.swap.production</field>
        <field name="view_mode">form</field>
        <field
            name="groups_id"
            eval="[(4, ref('mrp_swap_production.group_swap_production'))]"
        />
        <field name="target">new</field>
    </record>

    <!-- <act_window
        id="act_window_swap_production"
