<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="sale_order_form_view">
        <field name="name">sale.order.form@sale_account_traceability</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_traceability.sale_order_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='invoice_lines']" position="attributes">
                <attribute
                    name="groups"
                >sale_account_traceability.group_sale_account_traceability</attribute>
                <attribute
                    name="invisible"
                >display_type != False or (parent.state not in ['sale', 'done'] and invoice_lines == [])</attribute>
            </xpath>
            <xpath expr="//div[@name='traceability_container']" position="inside">
                <xpath expr="//div[@name='invoice_lines']" position="move" />
                <field
                    name="force_invoiced"
                    groups="sale_account_traceability.group_sale_account_traceability"
                />
                <button
                    type="object"
                    name="action_force_invoiced"
                    icon=""
                    string="Consider this line as fully invoiced"
                    class="oe_inline oe_link"
                    context="{}"
                    invisible="state not in ('sale', 'done')"
                    groups="sale_account_traceability.group_sale_account_traceability"
                />
            </xpath>
        </field>
    </record>
</odoo>
