<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="mrp_consume_wizard_view">
        <field name="name">MRP Consume</field>
        <field name="model">mrp.consume</field>
        <field name="arch" type="xml">
            <form string="Consume">
                <group>
                    <group>
                        <field name="company_id" invisible="1" />
                        <field name="production_id" invisible="1" />
                        <field name="product_id" readonly="1" />
                        <label for="product_qty" string="Quantity" />
                        <div class="o_row">
                            <field name="product_qty" />
                            <field
                                name="product_uom_id"
                                readonly="1"
                                groups="uom.group_uom"
                            />
                        </div>
                    </group>
                    <group>
                        <button
                            name="action_remove_make_to_order"
                            string="Only show products from stock"
                            type="object"
                            icon="fa-magic"
                        />
                    </group>
                </group>
                <group>
                    <field name="line_ids" invisible="not line_ids" nolabel="1">
                        <list
                            editable="top"
                            delete="0"
                            decoration-danger="(qty_to_consume &lt; qty_done) or (qty_done &gt; qty_reserved)"
                        >
                            <field
                                name="product_id"
                                readonly="move_id"
                                required="1"
                                domain="[('id', '!=', parent.product_id)]"
                                force_save="1"
                            />
                            <field name="qty_to_consume" readonly="1" force_save="1" />
                            <field name="qty_reserved" readonly="1" force_save="1" />
                            <field name="is_minimized" column_invisible="1" />
                            <button
                                name="action_minimize_qty_done"
                                title="Minimize"
                                type="object"
                                invisible="is_minimized"
                                icon="fa-backward"
                            />
                            <field name="qty_done" />
                            <field name="is_maximized" column_invisible="1" />
                            <button
                                name="action_maximize_qty_done_reserved"
                                title="Maximize"
                                type="object"
                                invisible="is_maximized"
                                icon="fa-forward"
                            />
                            <field
                                name="product_uom_id"
                                readonly="1"
                                force_save="1"
                                groups="uom.group_uom"
                            />
                            <field name="move_id" column_invisible="1" />
                        </list>
                    </field>
                </group>
                <footer>
                    <button
                        name="do_consume"
                        string="Consume"
                        confirm="Are you sure that you want to consume these lines?"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                    <button
                        name="action_minimize_qty_done"
                        string="Minimize all"
                        type="object"
                        icon="fa-fast-backward"
                    />
                    <button
                        name="action_maximize_qty_done_reserved"
                        string="Maximize all (reserved only)"
                        type="object"
                        icon="fa-fast-forward"
                    />
                    <button
                        name="action_maximize_qty_done_to_consume"
                        string="Maximize all"
                        type="object"
                        icon="fa-fast-forward"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_mrp_consume">
        <field name="name">Consume</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.consume</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
</odoo>
