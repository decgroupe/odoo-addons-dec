<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="city_list_view">
        <field name="name">res.city.list@l10n_fr_base_address_city_department</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_address_extended.view_city_tree" />
        <field name="arch" type="xml">
            <field name="country_id" position="before">
                <field name="department_id" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="view_city_form">
        <field name="name">res.city.form@l10n_fr_base_address_city_department</field>
        <field name="model">res.city</field>
        <field name="inherit_id" ref="base_location.view_city_form" />
        <field name="arch" type="xml">
            <field name="state_id" position="after">
                <field name="department_id" />
            </field>
        </field>
    </record>
</odoo>
