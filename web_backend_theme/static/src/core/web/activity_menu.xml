<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-inherit="mail.ActivityMenu" t-inherit-mode="extension">
        <!--
        Move the "View all activities" button on top (also fix unwanted scrollbars)
        -->
        <xpath expr="//t[@name='activityGroupLoop']" position="before">
            <xpath expr="//a[@t-on-click='openMyActivities']" position="move" />
        </xpath>
    </t>

</templates>
