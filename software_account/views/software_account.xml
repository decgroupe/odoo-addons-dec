<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="software_account_tree_view">
        <field name="name">software.account.tree@software_account</field>
        <field name="model">software.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="supplier_id" />
                <field name="login" />
                <field name="password" />
                <field name="email" />
                <field name="firstname" />
                <field name="lastname" />
                <field name="product_id" optional="hide" />
                <field name="production_id" optional="hide" />
                <field name="partner_id" optional="hide" />
                <field name="datetime" optional="hide" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="software_account_form_view">
        <field name="name">software.account.form@software_account</field>
        <field name="model">software.account</field>
        <field name="arch" type="xml">
            <form string="Account">
                <sheet>
                    <field
                        name="supplier_image"
                        widget="image"
                        class="oe_avatar"
                        options="{
                            'placeholder': '/base/static/img/company_image.png',
                            'img_class': 'object-fit-contain'
                        }"
                    />
                    <div class="oe_title">
                        <label for="login" />
                        <h1>
                            <field name="login" placeholder="Login" />
                        </h1>
                        <field
                            name="supplier_id"
                            placeholder="Supplier"
                            options="{'no_create': True}"
                        />
                    </div>
                    <notebook>
                        <page string="Credentials" name="credentials">
                            <group>
                                <group string="Authentication">
                                    <field name="password" />
                                    <field name="pin" />
                                </group>
                                <group string="Identity">
                                    <field name="email" />
                                    <field name="firstname" />
                                    <field name="lastname" />
                                </group>
                            </group>
                            <group string="Security Question">
                                <field
                                    name="question"
                                    nolabel="1"
                                    placeholder="Security question..."
                                />
                                <field
                                    name="answer"
                                    nolabel="1"
                                    placeholder="Answer..."
                                />
                            </group>
                        </page>
                        <page string="Links" name="links">
                            <group>
                                <field name="product_id" />
                                <field name="production_id" />
                                <field name="partner_id" />
                                <field name="datetime" />
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field
                                name="info"
                                nolabel="1"
                                placeholder="Additional information..."
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="software_account_search_view">
        <field name="name">software.account.search@software_account</field>
        <field name="model">software.account</field>
        <field name="arch" type="xml">
            <search string="Account">
                <field name="supplier_id" />
                <field name="login" />
                <field name="email" />
                <field name="firstname" />
                <field name="lastname" />
                <field name="product_id" />
                <field name="production_id" />
                <field name="partner_id" />
                <separator />
                <group string="Group By" name="groupby">
                    <filter
                        string="Supplier"
                        name="groupby_supplier_id"
                        context="{'group_by':'supplier_id'}"
                    />
                    <filter
                        string="Partner"
                        name="groupby_partner_id"
                        context="{'group_by':'partner_id'}"
                    />
                    <filter
                        string="Email"
                        name="groupby_email"
                        context="{'group_by':'email'}"
                    />
                    <filter
                        string="Product"
                        name="groupby_product_id"
                        context="{'group_by':'product_id'}"
                    />
                    <filter
                        string="Production"
                        name="groupby_production_id"
                        context="{'group_by':'production_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_window_software_account">
        <field name="name">Accounts</field>
        <field name="res_model">software.account</field>
        <field name="view_mode">form,list</field>
        <field name="view_id" ref="software_account_tree_view" />
        <field name="search_view_id" ref="software_account_search_view" />
    </record>

    <record
        model="ir.actions.act_window.view"
        id="act_window_view_software_account_tree"
    >
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="software_account_tree_view" />
        <field name="act_window_id" ref="act_window_software_account" />
    </record>

    <record
        model="ir.actions.act_window.view"
        id="act_window_view_software_account_form"
    >
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="software_account_form_view" />
        <field name="act_window_id" ref="act_window_software_account" />
    </record>
</odoo>
