#. module: sale_lock_manual
#: model_terms:ir.ui.view,arch_db:sale_lock_manual.view_order_form
msgid ""
"If the sale is locked, you can not modify it anymore. However, you will "
"still be able to invoice or deliver."
msgstr ""
"Si la vente est verrouillée, vous ne pouvez plus la modifier. Toutefois, "
"vous pourrez toujours facturer ou expédier."

#. module: sale_lock_manual
#: model_terms:ir.ui.view,arch_db:sale_lock_manual.view_order_form
msgid "Lock"
msgstr "Verrouiller"

#. module: sale_lock_manual
#: model:res.groups,name:sale_lock_manual.group_manual_done_setting
msgid "Lock Confirmed Sales Manually"
msgstr "Verrouiller manuellement les ventes confirmées"

#. module: sale_lock_manual
#: model_terms:ir.ui.view,arch_db:sale_lock_manual.view_order_form
msgid "Unlock"
msgstr "Déverrouiller"

