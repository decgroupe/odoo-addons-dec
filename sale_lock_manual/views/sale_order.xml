<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_order_form">
        <field name="name">sale.order.form@sale_lock_manual</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//form//header//button[@name='action_draft']" position="after">
                <button
                    name="action_lock"
                    type="object"
                    string="Lock"
                    invisible="locked or state != 'sale'"
                    help="If the sale is locked, you can not modify it anymore. However, you will still be able to invoice or deliver."
                    groups="sale_lock_manual.group_manual_done_setting"
                />
                <button
                    name="action_unlock"
                    type="object"
                    string="Unlock"
                    invisible="not locked"
                    groups="sale_lock_manual.group_manual_done_setting"
                />
            </xpath>
        </field>
    </record>
</odoo>
