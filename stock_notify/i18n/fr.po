#. module: stock_notify
#: model:ir.model.fields,help:stock_notify.field_stock_move__notify_assigned
msgid ""
"If checked, the picking owner will receive a notification when this move "
"becomes assigned"
msgstr ""
"Si coché, le propriétaire du bon recevra une notification lorsque ce "
"transfert sera disponbile"

#. module: stock_notify
#: model:ir.model.fields,field_description:stock_notify.field_stock_move__notify_assigned
msgid "Notify Assigned"
msgstr "Notifier la disponibilité"

#. module: stock_notify
#. odoo-python
#: code:addons/stock_notify/models/stock_move.py:0
msgid ""
"Product <small><b>%(product)s</b></small> was reserved and is now ready to "
"be picked up for <small><b>%(origin)s</b></small>.<br>Please open and "
"validate %(picking)s."
msgstr ""
"L'article <small><b>%(product)s</b></small> a été réservé et est "
"maintenant prêt à être récupéré pour <small><b>%(origin)s</b></small>."
"<br>Veuillez ouvrir et validez %(picking)s."

