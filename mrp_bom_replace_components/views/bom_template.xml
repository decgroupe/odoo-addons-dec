<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="track_bom_line_template">
        <div>
            <strong>Some products have been replaced using replacement wizard.</strong>
            <small>
                <table class="note_table">
                    <thead>
                        <tr>
                            <th>Line</th>
                            <th>Before</th>
                            <th>After</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="lines" t-as="bom_line">
                            <tr t-attf-class="{{ bom_line_parity }}">
                                <td>
                                    L<small><t t-out="bom_line.sequence" />:</small>
                                </td>
                                <td>
                                    <t t-out="bom_line_value['before'].display_name" />
                                </td>
                                <td>
                                    <t t-out="bom_line_value['after'].display_name" />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </small>
        </div>
    </template>
</odoo>
