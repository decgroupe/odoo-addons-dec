<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="replace_bom_components_form_view">
        <field name="name">replace.bom.components@mrp_bom_replace_components</field>
        <field name="model">replace.bom.components</field>
        <field name="arch" type="xml">
            <form string="Select Options">
                <p class="oe_grey">
                    Select a product existing in at least one bill of materials
                    and choose a new product that will replace it in all
                    selected bill of materials.
                </p>
                <group>
                    <field name="bom_product_ids" invisible="1" />
                    <field name="replacement_ids">
                        <list editable="bottom">
                            <field name="owner_id" column_invisible="1" />
                            <field
                                name="previous_product_id"
                                domain="[('id', 'in', parent.bom_product_ids)]"
                                options="{'no_create_edit': True, 'no_quick_create': True}"
                            />
                            <field
                                name="new_product_id"
                                options="{'no_create_edit': True, 'no_quick_create': True}"
                            />
                        </list>
                        <form string="Mapping">
                            <field name="previous_product_id" />
                            <field name="new_product_id" />
                        </form>
                    </field>
                </group>
                <footer>
                    <button
                        class="btn-primary"
                        string="Confirm Replacement (delayed)"
                        confirm="Do you want to proceed replacement?"
                        name="action_replace"
                        type="object"
                        default_focus="1"
                        context="{}"
                    />
                    <button
                        class="btn-primary"
                        string="Confirm Replacement (immediate)"
                        confirm="Do you want to proceed replacement?"
                        name="action_replace_immediately"
                        type="object"
                        context="{}"
                    />
                    <button
                        class="btn-secondary"
                        string="Cancel"
                        special="cancel"
                        context="{}"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_window_replace_bom_components">
        <field name="name">🧙‍♂️ Replace components ...</field>
        <field name="binding_model_id" ref="mrp.model_mrp_bom" />
        <field name="binding_view_types">list</field>
        <field name="res_model">replace.bom.components</field>
        <field name="view_mode">form</field>
        <field name="binding_type">action</field>
        <field name="target">new</field>
    </record>
</odoo>
