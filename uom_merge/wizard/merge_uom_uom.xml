<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="merge_uom_uom_wizard_form" model="ir.ui.view">
        <field name='name'>merge.uom.uom.wizard.form@uom_merge</field>
        <field name='model'>merge.uom.uom.wizard</field>
        <field name='arch' type='xml'>
            <form string='🧙‍♂️ Merge Wizard'>
                <sheet>
                    <field name="state" invisible="1" />
                    <group invisible="state in ('option', 'finished')" col="1">
                        <p class="oe_grey">
                            Selected records will be merged together.
                            All documents linked to one of these record
                            will be redirected to the destination record.
                            You can remove records from this list to avoid merging them.
                        </p>
                        <group col="2">
                            <field
                                name="dst_object_id"
                                domain="[('id', 'in', object_ids or False)]"
                                required="state == 'selection'"
                            />
                        </group>
                        <field
                            name="object_ids"
                            nolabel="1"
                            context="{'active_test': False}"
                        />
                    </group>
                </sheet>
                <footer>
                    <button
                        name='action_merge'
                        string='Merge Records'
                        class='oe_highlight'
                        type='object'
                        invisible="state in ('option', 'finished')"
                    />
                    <button
                        name='action_skip'
                        string='Skip these records'
                        type='object'
                        invisible="state != 'selection'"
                    />
                    <button
                        special="cancel"
                        string="Cancel"
                        type="object"
                        class="btn btn-secondary oe_inline"
                        invisible="state == 'finished'"
                    />
                    <button
                        special="cancel"
                        string="Close"
                        type="object"
                        class="btn btn-secondary oe_inline"
                        invisible="state != 'finished'"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_uom_uom_merge">
        <field name="name">🧙‍♂️ Merge ...</field>
        <field name="binding_model_id" ref="uom.model_uom_uom" />
        <field name="binding_view_types">list</field>
        <field name="res_model">merge.uom.uom.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_type">action</field>
        <field
            name="groups_id"
            eval="[Command.link(ref('uom_merge.res_group_do_merge'))]"
        />
        <field name="target">new</field>
        <field name="context">{
            'active_test': False,
            'skip_uom_category_validation': True
        }</field>
    </record>
</odoo>
