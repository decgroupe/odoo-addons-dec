<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="mass_editing_wizard_form_view">
        <field name="name">mass.editing.wizard@mass_editing_chat</field>
        <field name="model">mass.editing.wizard</field>
        <field
            name="inherit_id"
            ref="server_action_mass_edit.view_mass_editing_wizard_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_field_list']" position="after">
                <group name="group_chat" invisible="not chat_enabled">
                    <div
                        class="alert alert-warning"
                    >Use the below editor to post an internal message to each selected record</div>
                    <field name="chat_message" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
