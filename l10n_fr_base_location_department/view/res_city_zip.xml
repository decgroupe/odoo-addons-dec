<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="city_zip_form_view">
        <field name="name">res.city.zip.form@l10n_fr_base_location_department</field>
        <field name="model">res.city.zip</field>
        <field name="inherit_id" ref="base_location.city_zip_form" />
        <field name="arch" type="xml">
            <field name="city_id" position="after">
                <field name="department_id" />
                <field name="state_id" />
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="city_zip_list_view">
        <field name="name">res.city.zip.list@l10n_fr_base_location_department</field>
        <field name="model">res.city.zip</field>
        <field name="inherit_id" ref="base_location.city_zip_tree" />
        <field name="arch" type="xml">
            <field name="city_id" position="after">
                <field name="department_id" optional="hide" />
                <field name="state_id" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
