<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="procurement_group_tree_view">
        <field name="name">procurement.group.list@procurement_traceability</field>
        <field name="model">procurement.group</field>
        <field name="type">list</field>
        <field eval="1" name="priority" />
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="move_type" />
                <field name="partner_id" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="procurement_group_form_view">
        <field name="name">procurement.group.form@procurement_traceability</field>
        <field name="model">procurement.group</field>
        <field name="type">form</field>
        <field eval="1" name="priority" />
        <field name="arch" type="xml">
            <form string="Procurement group">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_view_pickings"
                            invisible="picking_count == 0"
                            class="oe_stat_button"
                            icon="fa-truck"
                        >
                            <field
                                name="picking_count"
                                widget="statinfo"
                                string="Pickings"
                            />
                        </button>
                        <button
                            type="object"
                            name="action_view_stock_moves"
                            invisible="stock_move_count == 0"
                            class="oe_stat_button"
                            icon="fa-arrows-v"
                        >
                            <field
                                name="stock_move_count"
                                widget="statinfo"
                                string="Stock Moves"
                            />
                        </button>
                        <button
                            type="object"
                            name="action_view_orderpoints"
                            invisible="orderpoint_count == 0"
                            class="oe_stat_button"
                            icon="fa-refresh"
                        >
                            <field
                                name="orderpoint_count"
                                widget="statinfo"
                                string="Reordering Rules"
                            />
                        </button>
                        <button
                            type="object"
                            name="action_view_stock_rules"
                            invisible="stock_rule_count == 0"
                            class="oe_stat_button"
                            icon="fa-cogs"
                        >
                            <field
                                name="stock_rule_count"
                                widget="statinfo"
                                string="Routes"
                            />
                        </button>
                    </div>
                    <notebook>
                        <page string="General">
                            <group name="general">
                                <field name="name" />
                                <field name="move_type" />
                                <field name="partner_id" />
                            </group>
                        </page>
                        <page
                            string="Pickings"
                            name="pickings"
                            invisible="not picking_ids"
                        >
                            <field name="picking_ids" />
                        </page>
                        <page
                            string="Stock Moves"
                            name="stock_moves"
                            invisible="not stock_move_ids"
                        >
                            <field name="stock_move_ids" />
                        </page>
                        <page
                            string="Reordering Rules"
                            name="orderpoints"
                            invisible="not orderpoint_ids"
                        >
                            <field name="orderpoint_ids" />
                        </page>
                        <page
                            string="Routes"
                            name="routes"
                            invisible="not stock_rule_ids"
                        >
                            <field name="stock_rule_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_window_procurement_group">
        <field name="name">Procurements</field>
        <field name="path">procurements</field>
        <field name="res_model">procurement.group</field>
        <field name="view_mode">form,list</field>
        <field name="view_id" ref="procurement_group_tree_view" />
    </record>

    <record
        model="ir.actions.act_window.view"
        id="act_window_view_procurement_group_tree"
    >
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="procurement_group_tree_view" />
        <field name="act_window_id" ref="act_window_procurement_group" />
    </record>

    <record
        model="ir.actions.act_window.view"
        id="act_window_view_procurement_group_form"
    >
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="procurement_group_form_view" />
        <field name="act_window_id" ref="act_window_procurement_group" />
    </record>
</odoo>
