<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_sale_service_inherit_form2">
        <field name="name">sale.service.form.view.inherit@mrp_project_task</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <field name="user_ids" position="after">
                <field
                    name="production_id"
                    invisible="not production_id"
                    readonly="1"
                    context="{
                        'create': False,
                        'edit': False,
                        'delete': False
                    }"
                />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="view_task_kanban">
        <field name="name">project.task.kanban@mrp_project_task</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban/progressbar" position="before">
                <field name="production_id" />
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="before">
                <div t-if="record.production_id.raw_value">
                    <i class="fa fa-wrench" title="Production" />
                    <t t-out="record.production_id.value" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
