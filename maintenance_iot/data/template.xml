<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="maintenance_iot.request_create">
        <p>Request created from <t t-out="ip_addr" /></p>
        <ul>
            <t t-foreach="data" t-as="item">
                <li>
                    <t t-out="item" />: <t t-out="data[item]" />
                </li>
            </t>
        </ul>
        <p t-if="user and assigned_reason">
            <t t-out="user.display_name" /> has been assigned because: <t
            t-out="assigned_reason"
        />
        </p>
    </template>

    <template id="maintenance_iot.request_update">
        <p>Request updated from <t t-out="ip_addr" />:</p>
        <ul>
            <t t-foreach="data" t-as="item">
                <li>
                    <t t-out="item" />: <t t-out="data[item]" />
                </li>
            </t>
        </ul>
    </template>

    <template id="maintenance_iot.request_close">
        <p>Request closed from <t t-out="ip_addr" /></p>
        <p t-if="closed_reason">
            This request has been closed because: <t t-out="closed_reason" />
        </p>
    </template>

    <template id="maintenance_iot.request_ping">
        <p>Request ping from <t t-out="ip_addr" /></p>
    </template>
</odoo>
