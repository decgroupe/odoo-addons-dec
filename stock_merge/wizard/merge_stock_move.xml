<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="merge_stock_move_wizard_form">
        <field name="name">merge.stock.move.wizard.form@stock_merge</field>
        <field name="model">merge.stock.move.wizard</field>
        <field name="arch" type="xml">
            <form string="🧙‍♂️ Merge Wizard">
                <sheet>
                    <field name="state" invisible="1" />
                    <separator
                        string="Merge the following moves"
                        invisible="state in ('option', 'finished')"
                    />
                    <group invisible="state in ('option', 'finished')" col="1">
                        <p class="oe_grey">
                            Selected moves will be merged together. All
                            documents linked to one of these moves will be
                            redirected to the destination move. You can remove
                            moves from this list to avoid merging them.
                        </p>
                        <group col="2">
                            <field
                                name="dst_object_id"
                                domain="[('id', 'in', object_ids or False)]"
                                required="state == 'selection'"
                            />
                        </group>
                        <field name="object_ids" nolabel="1" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_merge"
                        string="Merge Moves"
                        class="oe_highlight"
                        type="object"
                        invisible="state in ('option', 'finished')"
                    />
                    <button
                        name="action_skip"
                        string="Skip these moves"
                        type="object"
                        invisible="state != 'selection'"
                    />
                    <button
                        special="cancel"
                        string="Cancel"
                        type="object"
                        class="btn btn-secondary oe_inline"
                        invisible="state == 'finished'"
                    />
                    <button
                        special="cancel"
                        string="Close"
                        type="object"
                        class="btn btn-secondary oe_inline"
                        invisible="state != 'finished'"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_stock_move_merge">
        <field name="name">🧙‍♂️ Merge ...</field>
        <field name="binding_model_id" ref="stock.model_stock_move" />
        <field name="binding_view_types">list</field>
        <field name="res_model">merge.stock.move.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_type">action</field>
        <field name="groups_id" eval="[(4, ref('stock_merge.res_group_do_merge'))]" />
        <field name="target">new</field>
    </record>
</odoo>
