#. module: stock_merge
#: model_terms:ir.ui.view,arch_db:stock_merge.merge_stock_move_wizard_form
msgid ""
"Selected moves will be merged together. All\n"
"                            documents linked to one of these moves will be\n"
"                            redirected to the destination move. You can remove\n"
"                            moves from this list to avoid merging them."
msgstr ""
"Les mouvements sélectionnés seront fusionnés.\n"
"                             Tous les documents liés à l'un de ces mouvements\n"
"                             seront redirigés vers le mouvement de destination.\n"
"                             Vous pouvez enlever des mouvements de cette liste pour éviter de les fusionner."

