#. module: procurement_run_manufacture_warnings
#. odoo-python
#: code:addons/procurement_run_manufacture_warnings/models/stock_rule.py:0
msgid ""
"Bill of Material %(bom)s is empty for the product %(product)s.\n"
"Please add at least one component to this Bill of Material."
msgstr ""
"La nomenclature %(bom)s est vide pour l'article %(product)s.\n"
"Merci d'ajouter au moins un composant à cette nomenclature."

#. module: procurement_run_manufacture_warnings
#. odoo-python
#: code:addons/procurement_run_manufacture_warnings/models/stock_rule.py:0
msgid "Cannot manufacture product %(name)s, because it is archived. "
msgstr ""
"Impossible de fabriquer l'article %(name)s, car celui-ci est archivé. "

#. module: procurement_run_manufacture_warnings
#. odoo-python
#: code:addons/procurement_run_manufacture_warnings/models/stock_rule.py:0
msgid ""
"Cannot manufacture product %(name)s, state is \"%(state)s\".\n"
"Please change its state to \"%(draft)s\" or \"%(sellable)s\"."
msgstr ""
"Impossible de fabriquer l'article %(name)s, son état est « %(state)s ».\n"
"Veuillez modifier son état pour « %(draft)s » ou « %(sellable)s »."

#. module: procurement_run_manufacture_warnings
#: model:ir.model,name:procurement_run_manufacture_warnings.model_stock_rule
msgid "Stock Rule"
msgstr "Règle de stock"

#. module: procurement_run_manufacture_warnings
#. odoo-python
#: code:addons/procurement_run_manufacture_warnings/models/stock_rule.py:0
msgid ""
"There is no Bill of Material found for the product %(name)s. Please define "
"a Bill of Material for this product."
msgstr ""
"Aucune nomenclature n'a été trouvée pour l'article %(name)s. Définissez une "
"nomenclature pour cet article."

