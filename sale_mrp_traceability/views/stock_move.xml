<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="stock_move_tree_view">
        <field name="name">stock.move.list.picking.button@sale_mrp_traceability</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" create="false">
                <field name="id" widget="widget_id" groups="base.group_erp_manager" />
                <field name="product_id" />
                <field name="product_uom" />
                <field name="state" />
                <field name="action_view_created_item_visible" invisible="1" />
                <field
                    name="pick_status"
                    string="Procurement status"
                    class="d_move_procurement_status"
                />
                <button
                    name="action_view_created_item"
                    title="Open"
                    type="object"
                    invisible="not action_view_created_item_visible"
                    icon="fa-external-link"
                />
            </list>
        </field>
    </record>
</odoo>
