<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.actions.act_window" id="base.open_module_tree">
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.view" id="module_kanban_view">
        <field name="name">Apps Kanban@base_module_search</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_view_kanban" />
        <field name="arch" type="xml">
            <xpath
                expr="//kanban//footer/a[@t-att-href='record.website.raw_value']"
                position="attributes"
            >
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//kanban//footer/a[@type='edit']" position="attributes">
                <attribute name="invisible">False</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="ir_module_module_tree_view">
        <field name="name">ir.module.module.list@base_module_search</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='shortdesc']" position="before">
                <field
                    name="icon_image"
                    widget="image"
                    options="{'size': [24, 24]}"
                    width="28"
                />
            </xpath>
        </field>
    </record>
</odoo>
