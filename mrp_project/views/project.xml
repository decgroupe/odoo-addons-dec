<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record model="ir.ui.view" id="edit_project_form_view">
        <field name="name">project.project.form@mrp_project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    type="object"
                    icon="fa-wrench"
                    name="action_view_productions"
                    context="{
                        'search_default_project_id': id,
                        'default_project_id': id
                    }"
                >
                    <field
                        string="Productions"
                        name="production_count"
                        widget="statinfo"
                    />
                </button>
            </xpath>
            <xpath expr="//field[@name='label_tasks']" position="after">
                <field
                    name="label_productions"
                    string="Name of the Productions"
                    placeholder="e.g. Productions"
                />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_project_kanban">
        <field name="name">project.project.kanban@mrp_project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//a[@name='action_view_tasks']" position="after">
                <a
                    class="o_project_kanban_box me-1"
                    name="action_view_productions"
                    type="object"
                    context="{
                        'search_default_project_id': id,
                        'default_project_id': id
                    }"
                >
                    <div>
                        <field name="production_count" class="o_value" />
                        <field name="label_productions" class="ms-1" />
                    </div>
                </a>
            </xpath>
        </field>
    </record>

    <record id="view_project_search" model="ir.ui.view">
        <field name="name">project.project.select@mrp_project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <filter
                    string="Open Productions"
                    name="filter_open_productions"
                    domain="[('todo_production_count', '&gt;', 0)]"
                />
            </xpath>
        </field>
    </record>
</odoo>
