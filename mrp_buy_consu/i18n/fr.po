msgid "Bill of Material Line"
msgstr "Ligne de nomenclature"

#. module: mrp_buy_consu
#: model:ir.model.fields,field_description:mrp_buy_consu.field_mrp_bom_line__buy_consumable
msgid "Buy"
msgstr "Acheter"

#. module: mrp_buy_consu
#: model:ir.model.fields,help:mrp_buy_consu.field_mrp_bom_line__product_type
msgid ""
"Goods are tangible materials and merchandise you provide.\n"
"A service is a non-material product you provide."
msgstr ""
"Les biens sont des matériaux tangibles et des marchandises que vous "
"fournissez.\n"
"Un service est un produit non matériel que vous fournissez."

#. module: mrp_buy_consu
#: model:ir.model.fields,help:mrp_buy_consu.field_mrp_bom_line__product_small_supply
msgid ""
"If checked, then this product will be considered like a consumable "
"stockable product"
msgstr ""
"Si coché, alors ce produit sera consideré comme un consommable stockable"

#. module: mrp_buy_consu
#: model:ir.model.fields,field_description:mrp_buy_consu.field_mrp_bom_line__product_is_consumable
msgid "Is Consumable"
msgstr "Est consommable"

#. module: mrp_buy_consu
#: model:ir.model.fields,field_description:mrp_buy_consu.field_mrp_bom_line__product_type
msgid "Product Type"
msgstr "Type d'article"

#. module: mrp_buy_consu
#: model:ir.model.fields,field_description:mrp_buy_consu.field_mrp_bom_line__product_small_supply
