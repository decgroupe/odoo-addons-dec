<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.actions.act_window" id="action_mrp_production_stock_moves">
        <field name="name">Stock Moves</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">
            [
                '|',
                ('raw_material_production_id', '=', active_id),
                ('production_id', '=', active_id)
            ]
        </field>
    </record>

    <record model="ir.ui.view" id="stock_move_tree_view">
        <field name="name">stock.move.list.picking.button@mrp_traceability</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" create="false">
                <field name="id" widget="widget_id" groups="base.group_erp_manager" />
                <field name="name" />
                <field name="product_id" />
                <field name="product_uom_qty" />
                <field name="product_uom" />
                <field name="location_id" />
                <field name="location_dest_id" />
                <field name="origin" />
                <field name="state" />
                <field name="picking_id" />
                <button
                    name="action_view_picking"
                    string="Open"
                    type="object"
                    invisible="not picking_id"
                    icon="fa-truck"
                />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_move_form_view">
        <field name="name">stock.move.form@mrp_traceability</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='linked_group']/field[@name='move_orig_ids']"
                position="attributes"
            >
                <attribute name="invisible">not move_orig_ids</attribute>
            </xpath>
            <xpath
                expr="//group[@name='linked_group']/field[@name='move_orig_ids']"
                position="after"
            >
                <field
                    name="move_conv_orig_ids"
                    context="{'list_view_ref':'mrp_traceability.stock_move_tree_view'}"
                    invisible="not move_conv_orig_ids"
                />
            </xpath>
            <xpath
                expr="//group[@name='linked_group']/field[@name='move_dest_ids']"
                position="attributes"
            >
                <attribute name="invisible">not move_dest_ids</attribute>
            </xpath>
            <xpath
                expr="//group[@name='linked_group']/field[@name='move_dest_ids']"
                position="after"
            >
                <field
                    name="move_conv_dest_ids"
                    context="{'list_view_ref':'mrp_traceability.stock_move_tree_view'}"
                    invisible="not move_conv_dest_ids"
                />
            </xpath>
        </field>
    </record>
