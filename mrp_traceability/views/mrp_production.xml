<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="mrp_production_form_view">
        <field name="name">mrp.production.form@mrp_traceability</field>
        <field name="model">mrp.production</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field
                    name="orderpoint_id"
                    readonly="1"
                    invisible="not orderpoint_id"
                />
            </field>
            <button name="action_view_mo_delivery" position="before">
                <button
                    name="%(action_mrp_production_stock_moves)d"
                    type="action"
                    string="Stock Moves"
                    class="oe_stat_button"
                    icon="fa-arrows-v"
                    invisible="state not in ('progress', 'done')"
                    help="Open (mrp_traceability) list view with all `stock.move` linked to this manufacturing order."
                    groups="base.group_erp_manager"
                />
            </button>

            <xpath expr="//field[@name='move_raw_ids']/list" position="attributes">
                <attribute name="class">d_mrp_production</attribute>
            </xpath>
            <xpath
                expr="//field[@name='move_raw_ids']/list/field[@name='name']"
                position="attributes"
            >
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath
                expr="//field[@name='move_raw_ids']/list/field[@name='bom_line_id']"
                position="attributes"
            >
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath
                expr="//field[@name='move_raw_ids']/list/field[@name='is_locked']"
                position="attributes"
            >
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath
                expr="//field[@name='move_raw_ids']/list/field[@name='location_dest_id']"
                position="attributes"
            >
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath
                expr="//field[@name='move_raw_ids']/list/field[@name='location_dest_id']"
                position="after"
            >
                <field name="location_final_id" optional="hide" />
                <field name="move_orig_ids" widget="many2many_tags" optional="hide" />
                <field name="move_dest_ids" widget="many2many_tags" optional="hide" />
                <field
                    name="move_conv_orig_ids"
                    widget="many2many_tags"
                    optional="hide"
                />
                <field
                    name="move_conv_dest_ids"
                    widget="many2many_tags"
                    optional="hide"
                />
            </xpath>
            <xpath
                expr="//field[@name='move_raw_ids']/list/field[@name='state']"
                position="attributes"
            >
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath
                expr="//field[@name='move_raw_ids']/list/field[@name='manual_consumption']"
                position="attributes"
            >
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath
                expr="//field[@name='move_raw_ids']/list/field[@name='group_id']"
                position="attributes"
            >
                <attribute name="column_invisible">False</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="mrp_production_finished_products_form_view">
        <field
            name="name"
        >mrp.production.form+finished_products@mrp_traceability</field>
        <field name="model">mrp.production</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="mrp_traceability.mrp_production_form_view" />
        <field name="arch" type="xml">
            <page name="components" position="after">
                <page name="finished_products" string="Finished Products">
                    <field name="move_finished_ids" position="move">
                        <!--
                            - Same list from /addons/mrp/views/mrp_production_views.xml
                            - optional="hide" added to each field nodes
                            - Content is extended below using xpath
                        -->
                        <list editable="bottom">
                            <field name="product_id" readonly="state == 'done'" />
                            <field name="product_uom_qty" readonly="state == 'done'" />
                            <field name="product_uom" groups="uom.group_uom" />
                            <field name="operation_id" optional="hide" />
                            <field name="byproduct_id" optional="hide" />
                            <field name="name" optional="hide" />
                            <field name="date_deadline" optional="hide" />
                            <field name="picking_type_id" optional="hide" />
                            <field name="location_id" optional="hide" />
                            <field name="location_dest_id" optional="hide" />
                            <field name="company_id" optional="hide" />
                            <field name="warehouse_id" optional="hide" />
                            <field name="origin" optional="hide" />
                            <field name="group_id" optional="hide" />
                            <field name="propagate_cancel" optional="hide" />
                            <field name="move_dest_ids" optional="hide" />
                            <field name="state" optional="hide" />
                            <field name="product_uom_category_id" optional="hide" />
                            <field name="allowed_operation_ids" optional="hide" />
                            <field name="quantity" optional="hide" />
                            <field name="picked" optional="hide" />
                            <field name="cost_share" optional="hide" />
                        </list>
                    </field>
                </page>
            </page>
            <xpath
                expr="//page[@name='finished_products']//field[@name='move_finished_ids']/list/field[@name='location_dest_id']"
                position="after"
            >
                <field name="location_final_id" optional="hide" />
                <field name="move_orig_ids" widget="many2many_tags" optional="hide" />
                <field name="move_dest_ids" widget="many2many_tags" optional="hide" />
                <field
                    name="move_conv_orig_ids"
                    widget="many2many_tags"
                    optional="hide"
                />
                <field
                    name="move_conv_dest_ids"
                    widget="many2many_tags"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>
</odoo>
