#. module: account_merge
#: model_terms:ir.ui.view,arch_db:account_merge.merge_account_account_tag_wizard_form
msgid ""
"Selected tags will be merged together. All documents\n"
"                            linked to one of these tags will be redirected to the\n"
"                            destination tag. You can remove tags from this list to\n"
"                            avoid merging them."
msgstr ""
"Les tags sélectionnés seront fusionnés.\n"
"                             Tous les documents liés à l'un de ces tags\n"
"                             seront redirigés vers le tag de destination.\n"
"                             Vous pouvez enlever des tags de cette liste pour éviter de les fusionner."

#. module: account_merge
#: model_terms:ir.ui.view,arch_db:account_merge.merge_account_tax_wizard_form
msgid ""
"Selected taxes will be merged together. All documents\n"
"                            linked to one of these taxes will be redirected to the\n"
"                            destination tax. You can remove taxes from this list to\n"
"                            avoid merging them."
msgstr ""
"Les taxes sélectionnées seront fusionnées.\n"
"                             Tous les documents liés à l'une de ces taxes\n"
"                             seront redirigés vers la taxe de destination.\n"
"                             Vous pouvez enlever des taxes de cette liste pour éviter de les fusionner."

