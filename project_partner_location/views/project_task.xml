<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="project_task_form">
        <field name="name">project.task.form@project_partner_location</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field
                    name="partner_shipping_id"
                    readonly="1"
                    invisible="not partner_shipping_id"
                />
                <field
                    name="partner_shipping_zip_id"
                    readonly="1"
                    invisible="not partner_shipping_zip_id"
                />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="project_task_tree">
        <field name="name">project.task.list.inherited@project_partner_location</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="partner_shipping_id" />
                <field name="partner_shipping_zip_id" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="view_task_kanban">
        <field name="name">project.task.kanban@project_partner_location</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='stage_id']" position="after">
                <field name="partner_shipping_id" />
                <field name="partner_shipping_zip_id" />
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <small name="partner_shipping_id">
                    <div t-if="record.partner_shipping_id.value">
                        <span
                            class="fa fa-truck me-1"
                            aria-label="Partner Shipping"
                            title="Partner Shipping"
                        />
                        <field class="text-truncate" name="partner_shipping_id" />
                    </div>
                    <div t-if="record.partner_shipping_zip_id.value">
                        <span
                            class="fa fa-map-marker me-1"
                            aria-label="Partner Shipping ZIP"
                            title="Partner Shipping ZIP"
                        />
                        <field class="text-truncate" name="partner_shipping_zip_id" />
                    </div>
                </small>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="project_task_search">
        <field name="name">project.task.search.form@project_partner_location</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form" />
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="filter_domain">
                [
                    '|',
                    ('partner_id', 'child_of', self),
                    ('partner_shipping_id', 'child_of', self),
                ]
                </attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="partner_shipping_zip_id" />
            </field>
        </field>
    </record>
</odoo>
