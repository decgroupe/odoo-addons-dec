<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="project_project_form">
        <field name="name">project.project.form@project_partner_location</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field
                    name="partner_shipping_id"
                    readonly="1"
                    invisible="not partner_shipping_id"
                />
                <field
                    name="partner_shipping_zip_id"
                    readonly="1"
                    invisible="not partner_shipping_zip_id"
                />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_project">
        <field name="name">project.project.list.select@project_partner_location</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_shipping_id" />
                <field name="partner_shipping_zip_id" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="view_project_kanban">
        <field name="name">project.project.kanban@project_partner_location</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='sequence']" position="after">
                <field name="partner_shipping_id" />
                <field name="partner_shipping_zip_id" />
            </xpath>
            <xpath
                expr="//t[@t-name='card']//span[@name='partner_name']"
                position="after"
            >
                <span
                    name="partner_shipping"
                    class="text-muted d-flex align-items-baseline small"
                    t-if="record.partner_shipping_id.value"
                >
                    <span
                        class="fa fa-truck me-2"
                        aria-label="Partner Shipping"
                        title="Partner Shipping"
                    />
                    <field class="text-truncate" name="partner_shipping_id" />
                </span>
                <span
                    name="partner_shipping_zip"
                    class="text-muted d-flex align-items-baseline small"
                    t-if="record.partner_shipping_zip_id.value"
                >
                    <span
                        class="fa fa-map-marker me-2"
                        aria-label="Partner Shipping ZIP"
                        title="Partner Shipping ZIP"
                    />
                    <field class="text-truncate" name="partner_shipping_zip_id" />
                </span>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="project_project_filter_view">
        <field name="name">project.project.select@project_partner_location</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter" />
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="filter_domain">
                [
                    '|',
                    ('partner_id', 'child_of', self),
                    ('partner_shipping_id', 'child_of', self),
                ]
                </attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="partner_shipping_zip_id" />
            </field>
            <filter name="company" position="after">
                <filter
                    string="Partner"
                    name="filter_partner"
                    context="{'group_by': 'partner_id'}"
                />
                <filter
                    string="Shipping Partner"
                    name="filter_partner_shipping"
                    context="{'group_by': 'partner_shipping_id'}"
                />
                <filter
                    string="Shipping Partner's ZIP"
                    name="filter_partner_shipping_zip"
                    context="{'group_by': 'partner_shipping_zip_id'}"
                />
            </filter>
        </field>
    </record>
</odoo>
