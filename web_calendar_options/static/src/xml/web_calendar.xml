<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web_calendar_options.CalendarOptionsPanel">
        <div class="o_calendar_options mt-4">
            <div
                class="o_calendar_options_header fw-bolder small text-muted text-uppercase mb-2"
            >
                <t t-esc="title" />
            </div>
            <div class="d-flex flex-column gap-3">
                <div class="o-checkbox form-check">
                    <input
                        type="checkbox"
                        id="o_calendar_option_weekends"
                        class="form-check-input"
                        t-att-checked="props.isWeekendVisible ? true : undefined"
                        t-on-change="onWeekendToggle"
                    />
                    <label for="o_calendar_option_weekends" class="form-check-label">
                        <t t-esc="labelWeekends" />
                    </label>
                </div>
                <div>
                    <label
                        for="o_calendar_option_slot_duration"
                        class="form-label mb-1 small text-muted"
                    >
                        <t t-esc="labelSlotDuration" />
                    </label>
                    <select
                        id="o_calendar_option_slot_duration"
                        class="form-select form-select-sm"
                        t-on-change="onSlotDurationChange"
                    >
                        <t
                            t-foreach="slotIntervals"
                            t-as="interval"
                            t-key="interval[0]"
                        >
                            <option
                                t-att-value="interval[0]"
                                t-att-selected="props.slotDuration === interval[0] ? true : undefined"
                            >
                                <t t-esc="interval[1]" />
                            </option>
                        </t>
                    </select>
                </div>
                <div>
                    <label
                        for="o_calendar_option_snap_duration"
                        class="form-label mb-1 small text-muted"
                    >
                        <t t-esc="labelSnapDuration" />
                    </label>
                    <select
                        id="o_calendar_option_snap_duration"
                        class="form-select form-select-sm"
                        t-on-change="onSnapDurationChange"
                    >
                        <t
                            t-foreach="slotIntervals"
                            t-as="interval"
                            t-key="interval[0]"
                        >
                            <option
                                t-att-value="interval[0]"
                                t-att-selected="props.snapDuration === interval[0] ? true : undefined"
                            >
                                <t t-esc="interval[1]" />
                            </option>
                        </t>
                    </select>
                </div>
            </div>
        </div>
    </t>

    <t t-inherit="web.CalendarController" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_calendar_sidebar')]" position="inside">
            <OptionsPanel t-props="optionsPanelProps" />
        </xpath>
    </t>

    <t t-inherit="calendar.AttendeeCalendarController" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_calendar_sidebar')]" position="inside">
            <OptionsPanel t-props="optionsPanelProps" />
        </xpath>
    </t>

</templates>
