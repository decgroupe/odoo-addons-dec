<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.base.setup@mail_activity_redirection</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="30" />
        <field name="inherit_id" ref="mail.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="inside">
                <setting
                    string="Activities Redirection"
                    help="Redirect activities to a specific user"
                >
                    <button
                        name="%(mail_activity_redirection.act_window_mail_activity_redirection)d"
                        icon="fa-arrow-right"
                        type="action"
                        string="Manage redirections"
                        class="btn-link"
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
