<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="merge_project_project_wizard_form">
        <field name="name">merge.project.project.wizard.form@project_merge</field>
        <field name="model">merge.project.project.wizard</field>
        <field name="arch" type="xml">
            <form string='🧙‍♂️ Merge Wizard'>
                <sheet>
                    <field name="state" invisible="1" />
                    <separator
                        string="Merge the following records"
                        invisible="state in ('option', 'finished')"
                    />
                    <group invisible="state in ('option', 'finished')" col="1">
                        <p class="oe_grey">
                            Selected records will be merged together.
                            All documents linked to one of these record
                            will be redirected to the destination record.
                            You can remove records from this list to avoid merging them.
                        </p>
                        <group col="2">
                            <field
                                name="dst_object_id"
                                domain="[('id', 'in', object_ids or False)]"
                                required="state == 'selection'"
                            />
                        </group>
                        <field name="object_ids" nolabel="1" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_merge"
                        string="Merge Records"
                        class="oe_highlight"
                        type="object"
                        invisible="state in ('option', 'finished')"
                    />
                    <button
                        name="action_skip"
                        string="Skip these records"
                        type="object"
                        invisible="state != 'selection'"
                    />
                    <button
                        special="cancel"
                        string="Cancel"
                        type="object"
                        class="btn btn-secondary oe_inline"
                        invisible="state == 'finished'"
                    />
                    <button
                        special="cancel"
                        string="Close"
                        type="object"
                        class="btn btn-secondary oe_inline"
                        invisible="state != 'finished'"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_project_project_merge">
        <field name="name">🧙‍♂️ Merge ...</field>
        <field name="binding_model_id" ref="project.model_project_project" />
        <field name="binding_view_types">list</field>
        <field name="res_model">merge.project.project.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_type">action</field>
        <field name="groups_id" eval="[(4, ref('project_merge.res_group_do_merge'))]" />
        <field name="target">new</field>
    </record>
</odoo>
