<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Disable Super-Manager needed to create a project -->
    <record model="ir.ui.view" id="crm_timesheet_lead_view_form">
        <field name="name">crm.lead.form@project_crm_link</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm_timesheet.crm_lead_view_form" />
        <field name="arch" type="xml">
            <field name="project_id" position="attributes">
                <attribute
                    name="context"
                >{'bypass_supermanager_check': True}</attribute>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="crm_lead_view_form">
        <field name="name">crm.lead.oppor.inherited.crm@project_crm_link</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <page name="lead" position="before">
                <page name="projects" string="Related Projects">
                    <field
                        name="related_project_ids"
                        widget="many2many"
                        domain="[('linked_lead_id', '=', False)]"
                        context="{
                            'default_partner_id': partner_id,
                            'bypass_supermanager_check': True,
                        }"
                    />
                    <div class="alert alert-info" role="alert">
                        <span class="text-info">
                            <p>
                                <i
                                    class="fa fa-info-circle me-2 text-info"
                                    title="Warning"
                                />
                                <b>Related Projects:</b>
                                <p>
                                    To link an existing project, open the project and
                                    set the "Opportunity Link" field to this record or
                                    just use the "Add Line".
                                    <br />
                                    The purpose of this list is to group all projects
                                    related to this opportunity in one place for better
                                    visibility and management.
                                </p>
                                <i>Only projects that are not already linked to another
                                opportunity can be added here. (Projects automatically
                                created (by SO) are also listed here.)</i>
                            </p>
                        </span>
                    </div>
                </page>
            </page>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    type="object"
                    name="action_view_related_projects"
                    class="oe_stat_button"
                    icon="fa-puzzle-piece"
                    invisible="not related_project_count"
                >
                    <field
                        name="related_project_count"
                        widget="statinfo"
                        string="Related Projects"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
