#. module: project_crm_link
#: model_terms:ir.ui.view,arch_db:project_crm_link.crm_lead_view_form
msgid ""
"<i>Only projects that are not already linked to another\n"
"                                opportunity can be added here. (Projects "
"automatically\n"
"                                created (by SO) are also listed here.)</i>"
msgstr ""
"<i>Seuls les projets qui ne sont pas déjà associés à une autre\n"
"                                opportunité peuvent être ajoutés ici. (Les "
"projets créés automatiquement\n"
"                                (par SO) apparaissent également dans cette "
"liste.)</i>"

