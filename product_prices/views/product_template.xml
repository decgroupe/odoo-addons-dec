<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="name">product.template.form@product_prices</field>
        <field name="model">product.template</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <label for="list_price" position="before">
                <separator string="Sell price" colspan="2" />
            </label>
            <div name="list_price_uom" position="after">
                <field name="pricelist_bypass" invisible="not sale_ok" />
                <field
                    name="pricelist_bypass_item"
                    invisible="not sale_ok or not pricelist_bypass"
                    groups="base.group_erp_manager"
                />
                <label for="default_sell_price" invisible="not sale_ok" />
                <div name="default_sell_price" invisible="not sale_ok">
                    <field
                        name="default_sell_price"
                        class="default_price oe_inline"
                        widget="monetary"
                        options="{'currency_field': 'currency_id'}"
                    />
                    <button
                        icon="fa-sitemap"
                        name="open_price_graph"
                        string="Open Graph ..."
                        type="object"
                        context="{'sell_price':True}"
                        class="oe_inline"
                    />
                </div>
                <label
                    for="price_write_uid"
                    string="Edited"
                    groups="base.group_erp_manager"
                    invisible="not price_write_uid"
                />
                <div
                    name="price_write_editor"
                    groups="base.group_erp_manager"
                    invisible="not price_write_uid"
                >
                    <field
                        name="price_write_date"
                        class="oe_inline"
                        nolabel="1"
                        readonly="1"
                    />
                    <span> by </span>
                    <field name="price_write_uid" class="oe_inline" readonly="1" />
                </div>
            </div>
            <label for="standard_price" position="before">
                <separator string="Cost price and purchase price" colspan="2" />
            </label>
            <label for="standard_price" position="replace">
                <label
                    for="standard_price"
                    string="Purchase Price (PO) / Cost Price (MO)"
                    groups="base.group_user"
                    invisible="product_variant_count != 1 and not is_product_variant"
                />
            </label>
            <div name="standard_price_uom" position="after">
                <field name="same_uom" invisible="1" />
                <field
                    name="standard_price_po_uom"
                    widget='monetary'
                    invisible="not purchase_ok or same_uom"
                    options="{'currency_field': 'cost_currency_id', 'field_digits': True}"
                />
                <label
                    for="default_purchase_price_po_uom"
                    string="Purchase Prices"
                    invisible="not purchase_ok"
                />
                <div name="default_purchase_price" invisible="not purchase_ok">
                    <div>
                        <small>
                            <field
                                name="default_purchase_price"
                                nolabel="1"
                                invisible="same_uom"
                                class="default_price"
                                widget="monetary"
                                options="{'currency_field': 'cost_currency_id'}"
                            />
                        </small>
                    </div>
                    <div class="">
                        <field
                            name="default_purchase_price_po_uom"
                            class="default_price oe_inline"
                            widget="monetary"
                            options="{'currency_field': 'cost_currency_id'}"
                        />
                        <button
                            name="open_price_graph"
                            icon="fa-sitemap"
                            string="Open Graph ..."
                            type="object"
                            context="{'purchase_price':True}"
                            class="oe_inline"
                        />
                    </div>
                </div>
                <label
                    for="standard_price_write_uid"
                    string="Edited"
                    groups="base.group_erp_manager"
                    invisible="not standard_price_write_uid"
                />
                <div
                    name="standard_price_write_editor"
                    groups="base.group_erp_manager"
                    invisible="not standard_price_write_uid"
                >
                    <field
                        name="standard_price_write_date"
                        class="oe_inline"
                        nolabel="1"
                        readonly="1"
                    />
                    <span> by </span>
                    <field
                        name="standard_price_write_uid"
                        class="oe_inline"
                        readonly="1"
                    />
                </div>
            </div>
        </field>
    </record>
</odoo>
