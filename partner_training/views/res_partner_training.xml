<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="res_partner_training_list_view">
        <field name="name">res.partner.training.list@partner_training</field>
        <field name="model">res.partner.training</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field
                    name="specialty_ids"
                    string="Specialties or Sectors"
                    widget="many2many_tags"
                />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="res_partner_training_form_view">
        <field name="name">res.partner.training.form@partner_training</field>
        <field name="model">res.partner.training</field>
        <field name="arch" type="xml">
            <form string="Educational Training">
                <sheet>
                    <field name="active" invisible="1" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group name="title">
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" />
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>
                    </group>
                    <group name="main">
                        <label for="title" class="oe_edit_only" />
                        <field name="title" />
                        <field name="specialty_ids">
                            <list editable="bottom">
                                <field
                                    name="name"
                                    placeholder="Personal Care and Services Support"
                                />
                                <field name="acronym" placeholder="PCSS" />
                            </list>
                        </field>
                        <group name="primary" />
                        <group name="secondary" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="res_partner_training_action">
        <field name="name">Educational Trainings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner.training</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Educational Training
            </p>
            <p>
                Manage educational trainings to better classify orders for tracking and analysis purposes.
            </p>
        </field>
    </record>
</odoo>
