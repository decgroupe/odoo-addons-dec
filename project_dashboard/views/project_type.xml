<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="project_type_form">
        <field name="model">project.type</field>
        <field name="inherit_id" ref="project_type.project_type_form" />
        <field name="arch" type="xml">
            <div class="oe_title" position="inside">
                <div>
                    <field name="dashboard_ok" />
                    <label for="dashboard_ok" />
                </div>
            </div>
            <notebook position="inside">
                <page
                    string="Dashboard"
                    name="dashboard_page"
                    invisible="not dashboard_ok"
                >
                    <group name="main">
                        <group name="primary">
                            <field name="open_default_groupby" />
                            <field name="date_field" />
                        </group>
                        <group name="secondary" />
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record model="ir.ui.view" id="project_type_kanban_view">
        <field name="name">project.type.kanban</field>
        <field name="model">project.type</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" create="false" can_open="false">
                <field name="name" />
                <field name="color" />
                <field name="todo_project_count" />
                <field name="todo_project_count_unassigned" />
                <field name="todo_project_count_year_nm0" />
                <field name="todo_project_count_year_nm1" />
                <field name="todo_project_count_year_nm2" />
                <field name="kanban_dashboard" />
                <templates>
                    <t t-name="menu">
                        <a
                            role="menuitem"
                            name="action_open_all_projects"
                            type="object"
                            class="dropdown-item"
                        >Projects</a>
                        <a
                            role="menuitem"
                            name="action_open_all_projects_tasks"
                            type="object"
                            class="dropdown-item"
                        >Tasks</a>
                        <div role="separator" class="dropdown-divider" />
                        <a
                            class="dropdown-item"
                            role="menuitem"
                            type="open"
                            groups="!project.group_project_manager"
                        >View</a>
                        <a
                            class="dropdown-item"
                            role="menuitem"
                            type="open"
                            groups="project.group_project_manager"
                        >Settings</a>
                        <div role="separator" class="dropdown-divider" />
                        <field name="color" widget="kanban_color_picker" />
                    </t>
                    <t t-name="card" class="flex-row">
                        <t
                            t-value="JSON.parse(record.kanban_dashboard.raw_value)"
                            t-set="dashboard"
                        />
                        <aside class="o_kanban_aside_full" invisible="1" />

                        <main class="ps-2 ms-1">
                            <!-- Header -->
                            <field name="name" class="fw-bold fs-4 me-auto" />
                            <div class="text-muted mb-2" />
                            <!-- Two columns:
                            - left for the main action
                            - right for secondary actions. -->
                            <div class="row g-0 mb16 mt-1 me-2">
                                <!-- Main action: To-Do button -->
                                <t t-call="cardLeft" />
                                <!-- Secondary actions: other filters -->
                                <t t-call="cardRight" />
                            </div>
                            <div class="row mt-3">
                                <t t-call="cardBottom" />
                            </div>
                        </main>
                    </t>
                    <t t-name="cardLeft">
                        <div class="col-3">
                            <button
                                class="btn btn-primary"
                                name="action_open_projects_from_dashboard"
                                type="object"
                                context="{
                                    'search_default_filter_task_todo': 1,
                                    'search_default_filter_open_productions': 1
                                }"
                            >
                                <t t-esc="record.todo_project_count.value" /> To-do
                            </button>
                        </div>
                    </t>
                    <t t-name="cardRight">
                        <div class="col-7 offset-1">
                            <!-- Unassigned with count -->
                            <div class="d-flex">
                                <a
                                    name="action_open_projects_from_dashboard"
                                    type="object"
                                    context="{
                                        'search_default_unassigned_projects': 1,
                                        'search_default_filter_task_todo': 1,
                                        'search_default_filter_open_productions': 1
                                    }"
                                    class="mb0 me-auto fw-bold"
                                >Unassigned</a>
                                <t t-esc="record.todo_project_count_unassigned.value" />
                            </div>
                            <!-- Current Year with count -->
                            <div
                                class="d-flex"
                                t-if="1 or record.todo_project_count_year_nm0.value > 0"
                            >
                                <a
                                    name="action_open_projects_from_dashboard"
                                    type="object"
                                    context="{
                                        'search_default_filter_year_current': 1,
                                        'search_default_filter_task_todo': 1,
                                        'search_default_filter_open_productions': 1
                                    }"
                                    class="mb0 me-auto fw-bold"
                                >Current Year</a>
                                <t t-esc="record.todo_project_count_year_nm0.value" />
                            </div>
                            <!-- Previous Year with count -->
                            <div
                                class="d-flex"
                                t-if="1 or record.todo_project_count_year_nm1.value > 0"
                            >
                                <a
                                    name="action_open_projects_from_dashboard"
                                    type="object"
                                    context="{
                                        'search_default_filter_year_previous': 1,
                                        'search_default_filter_task_todo': 1,
                                        'search_default_filter_open_productions': 1
                                    }"
                                    class="mb0 me-auto fw-bold"
                                >Previous Year</a>
                                <t t-esc="record.todo_project_count_year_nm1.value" />
                            </div>
                            <!-- More Older with count -->
                            <div
                                class="d-flex"
                                t-if="1 or record.todo_project_count_year_nm2.value > 0"
                            >
                                <a
                                    name="action_open_projects_from_dashboard"
                                    type="object"
                                    context="{
                                        'search_default_filter_year_older': 1,
                                        'search_default_filter_task_todo': 1,
                                        'search_default_filter_open_productions': 1
                                    }"
                                    class="mb0 me-auto fw-bold"
                                >More Older</a>
                                <t t-esc="record.todo_project_count_year_nm2.value" />
                            </div>
                        </div>
                    </t>
                    <t t-name="projectLine">
                        <a
                            type="object"
                            name="action_open_project"
                            title="Open project form"
                            t-attf-context="{'project_id': #{project.id} }"
                        >
                            <span
                                style="display: inline-block; min-width: 14px; text-align: center;"
                            >
                                <t t-if="project.dashboard_sequence > 0">
                                    <i class="fa fa-thumb-tack" />
                                </t>
                                <t t-else="">
                                    <i class="fa fa-star" />
                                </t>
                            </span>
                        </a>
                        <span>&amp;nbsp;</span>
                        <a
                            name="action_open_project_tasks"
                            type="object"
                            title="View tasks"
                            t-attf-context="{'project_id': #{project.id} }"
                        >
                            <t t-esc="project.display_name" />
                            <t t-if="project.kanban_description">
                                <t t-esc="project.kanban_description" />
                            </t>
                        </a>
                    </t>
                    <t t-name="cardBottom">
                        <span class="text-truncate">
                            <ul
                                class="list-group list-group-flush flex-wrap flex-row flex-lg-column"
                            >
                                <t t-foreach="dashboard.projects" t-as="project">
                                    <li
                                        class="list-group-item flex-grow-1"
                                        style="padding: 0rem 0rem;"
                                    >
                                        <t t-call="projectLine" />
                                    </li>
                                </t>
                            </ul>
                        </span>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.actions.act_window" id="project_type_dashboard_action">
        <field name="name">Dashboard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.type</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('dashboard_ok', '=', True)]</field>
    </record>
</odoo>
