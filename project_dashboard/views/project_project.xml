<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.actions.act_window" id="action_project_kanban_from_dashboard">
        <field name="name">Project</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'default_type_id': active_id}</field>
        <field name="domain">[('type_id', 'child_of', active_id)]</field>
    </record>

    <record model="ir.actions.act_window" id="action_open_view_project">
        <field name="name">Project</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">form</field>
        <field name="domain">[]</field>
    </record>

    <record model="ir.ui.view" id="edit_project_form_view">
        <field name="name">project.project.form@project_dashboard</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='extra_settings']" position="inside">
                <group string="Dashboard" groups="base.group_no_one">
                    <field name="dashboard_sequence" groups="base.group_no_one" />
                </group>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="quick_create_project_form">
        <field name="name">project.project.form.quick_create@project_dashboard</field>
        <field name="model">project.project</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" />
                    <field name="type_id" />
                    <field name="user_id" domain="[('share', '=', False)]" />
                </group>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_project_kanban">
        <field name="name">project.project.kanban@project_dashboard</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute
                    name="quick_create_view"
                >project_dashboard.quick_create_project_form</attribute>
            </xpath>
            <xpath expr="//field[@name='display_name']" position="replace">
                <a type="open" class="text-primary">$0</a>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="project_project_filter_view">
        <field name="name">project.project.select@project_task_count</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter" />
        <field name="arch" type="xml">
            <xpath expr="//separator[last()]" position="after">
                <separator />
                <filter
                    string="Current Year"
                    name="filter_year_current"
                    domain="[
                        ('type_date', '&gt;=', datetime.date.today().strftime('%Y-01-01'))
                    ]"
                />
                <filter
                    string="Previous Year"
                    name="filter_year_previous"
                    domain="[
                        ('type_date', '&gt;=', (datetime.date.today() - relativedelta(years=1)).strftime('%Y-01-01')),
                        ('type_date', '&lt;', datetime.date.today().strftime('%Y-01-01')),
                    ]"
                />
                <filter
                    string="More Older"
                    name="filter_year_older"
                    domain="[
                        ('type_date', '&lt;=', (datetime.date.today() - relativedelta(years=2)).strftime('%Y-12-31'))
                    ]"
                />
            </xpath>
        </field>
    </record>
</odoo>
