<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="sale_order_form_view">
        <field name="name">sale.order.form@sale_project_traceability</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_traceability.sale_order_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='traceability_container']" position="inside">
                <div
                    name="tasks"
                    invisible="display_type != False or task_ids == []"
                    groups="sale_project_traceability.group_sale_project_traceability"
                >
                    <label for="task_ids" />
                    <field name="task_ids" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
