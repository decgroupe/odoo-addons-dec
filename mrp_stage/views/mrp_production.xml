<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="mrp_production_tree_view">
        <field name="name">mrp.production.tree@mrp_stage</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="stage_id" />
            </field>
            <field name="state" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="mrp_production_form_view">
        <field name="name">mrp.production.form@mrp_stage</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <!-- We cannot use `date_planned_start` as it is manual split label/value -->
            <field name="user_id" position="before">
                <field name="stage_id" groups="base.group_no_one" />
            </field>
            <button name="button_mark_done" position="before">
                <button
                    name="action_start"
                    string="Start Production"
                    invisible="state not in ('confirmed','planned')"
                    icon="fa-caret-right"
                    class="btn-success"
                    type="object"
                />
                <button
                    name="action_on_hold"
                    string="Put back on hold"
                    invisible="state not in ('progress','to_close')"
                    icon="fa-pause"
                    class="btn-light"
                    type="object"
                />
            </button>
            <xpath expr="//page[@name='miscellaneous']/group" position="inside">
                <group name="progress" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="mrp_production_filter_view">
        <field name="name">mrp.production.select@mrp_stage</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter" />
        <field name="mode">primary</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <filter
                    string="My Orders"
                    name="filter_my_order"
                    domain="[('user_id', '=', uid)]"
                />
                <separator />
            </field>
            <filter name="status" position="after">
                <filter
                    string="Stage"
                    name="group_stage"
                    domain="[]"
                    context="{'group_by':'stage_id'}"
                />
            </filter>
            <filter name="todo" position="replace">
                <filter
                    string="To Do"
                    name="filter_stage_todo"
                    domain="[('stage_todo','=',True)]"
                />
            </filter>
        </field>
    </record>

    <!-- Production Order Kanban View -->
    <record model="ir.ui.view" id="mrp_production_staged_kanban_view">
        <field name="name">mrp.production.kanban@mrp_stage</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="stage_id"
                class="_kanban_small_column o_opportunity_kanban"
                create="0"
                _order="date_deadline"
                group_create="false"
                group_edit="false"
                group_delete="false"
                groups_draggable="false"
                records_draggable="false"
                highlight_color="kanban_color"
            >
                <field name="state" />
                <field name="stage_id" />
                <field name="kanban_color" />
                <field name="name" />
                <field name="product_id" />
                <field name="bom_id" />
                <field name="user_id" />
                <field name="date_start" />
                <field name="date_finished" />
                <field name="activity_ids" />
                <field name="activity_state" />
                <templates>
                    <t t-name="menu">
                        <t
                            t-if="['confirmed', 'planned'].includes(record.state.raw_value)"
                        >
                            <a
                                role="menuitem"
                                name="action_start"
                                type="object"
                                class="dropdown-item"
                            ><i class="fa fa-caret-right" /> Start</a>
                        </t>
                        <a
                            role="menuitem"
                            name="action_assign_to_me"
                            type="object"
                            class="dropdown-item"
                        >Assign to Me</a>
                        <t t-if="widget.editable">
                            <a
                                role="menuitem"
                                type="open"
                                class="dropdown-item"
                            >Edit</a>
                        </t>
                        <t t-if="widget.deletable">
                            <a
                                role="menuitem"
                                type="delete"
                                class="dropdown-item"
                            >Delete</a>
                        </t>
                        <field name="kanban_color" widget="kanban_color_picker" />
                    </t>
                    <t t-name="card">
                        <div class="d-flex gap-1" name="main">
                            <div class="d-flex flex-column min-w-0 lh-sm">
                                <field class="fw-bold fs-5" name="name" />
                                <small>
                                    <i>
                                        <t
                                            t-if="luxon.DateTime.fromISO(record.date_finished.raw_value) &lt; luxon.DateTime.local()"
                                            t-set="date_finished_class"
                                        >text-danger</t>
                                        <span t-att-class="date_finished_class">
                                            <field name="date_finished" />
                                        </span>
                                    </i>
                                </small>
                                <small>
                                    <field name="bom_id" />
                                </small>
                            </div>
                            <field
                                name="product_id"
                                widget="image"
                                options="{'preview_image': 'image_128'}"
                            />
                            <widget
                                name="web_ribbon"
                                title="Done"
                                invisible="state != 'done'"
                            />
                        </div>
                        <div name="secondary" />
                        <div name="progress" class="o_kanban_record_progress" />
                        <footer class="pt-1">
                            <field name="activity_ids" widget="kanban_activity" />
                            <field
                                name="user_id"
                                widget="many2one_avatar_user"
                                domain="[('share', '=', False)]"
                                class="ms-auto"
                            />
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="act_mrp_production_staged" model="ir.actions.act_window">
        <field name="path">staged-manufacturing</field>
        <field name="name">Manufacturing Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('mrp_production_staged_kanban_view')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mrp.mrp_production_tree_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mrp.mrp_production_form_view')})]"
        />
        <field name="search_view_id" ref="mrp_production_filter_view" />
        <field name="context">{
            'search_default_filter_stage_todo': True,
            'search_default_group_stage': True,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Create a new manufacturing order
            </p>
        </field>
    </record>

    <!-- Override sequence from 1 to 5 to insert our new action -->
    <record model="ir.ui.menu" id="mrp.menu_mrp_production_action">
        <field name="sequence" eval="5" />
    </record>

    <record model="ir.ui.menu" id="menu_mrp_production_action_staged">
        <field name="name">Staged Manufacturing Orders</field>
        <field name="sequence" eval="3" />
        <field name="action" ref="act_mrp_production_staged" />
        <field name="parent_id" ref="mrp.menu_mrp_manufacturing" />
    </record>

    <!-- <menuitem action="act_mrp_production_staged" id="menu_mrp_production_action_staged" parent="mrp.menu_mrp_manufacturing" sequence="3"/> -->

    <record model="ir.actions.server" id="action_recompute_stage">
        <field name="name">⚡️ Recompute Stage Assignment</field>
        <field name="model_id" ref="mrp.model_mrp_production" />
        <field name="binding_model_id" ref="mrp.model_mrp_production" />
        <field name="state">code</field>
        <field name="code">action = records.action_recompute_stage_id()</field>
    </record>
</odoo>
