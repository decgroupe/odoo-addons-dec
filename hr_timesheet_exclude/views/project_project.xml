<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="project_project_form">
        <field name="name">project.project.form@hr_timesheet_exclude</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_time_managment']" position="inside">
                <setting
                    class="col-lg-12"
                    name="exclude_from_timesheet_setting"
                    help="Exclude any timesheet entries logged towards this project in Analysis view"
                    groups="base.group_no_one"
                >
                    <field name="exclude_from_timesheet" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
