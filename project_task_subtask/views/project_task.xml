<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="project_task_form_view">
        <field name="name">project.task.form@project_task_subtask</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group name="checklist">
                    <field name="default_user" invisible='True' />
                    <field
                        name="subtask_ids"
                        context="{'default_user_id': default_user}"
                    >
                        <list
                            editable="bottom"
                            decoration-danger="recolor == True"
                            decoration-muted="state == 'cancelled'"
                            decoration-success="state == 'done'"
                            decoration-info="state == 'waiting'"
                        >
                            <field name="name" widget="text" />
                            <field name="recolor" column_invisible='True' />
                            <field name="user_id" domain="[('share', '=', False)]" />
                            <field name="state" optional="show" />
                            <field name="note" optional="hide" />
                            <field name="hide_button" column_invisible='True' />
                            <button
                                name="change_state_done"
                                title="Change state to DONE"
                                type="object"
                                icon="fa-check"
                                invisible="state in ['done', 'cancelled'] or hide_button == True"
                            />
                            <button
                                name="change_state_todo"
                                title="Change state to TODO"
                                type="object"
                                icon="fa-caret-square-o-right"
                                invisible="state == 'todo' or hide_button == True"
                            />
                            <button
                                name="change_state_waiting"
                                type="object"
                                title="Change state to WAITING"
                                icon="fa-pause"
                                invisible="state == 'waiting' or hide_button == True"
                            />
                            <button
                                name="change_state_cancelled"
                                type="object"
                                title="Change state to CANCELLED"
                                icon="fa-ban"
                                invisible="state == 'cancelled' or hide_button == True"
                            />
                            <button
                                name="action_convert_to_task"
                                type="object"
                                title="Convert to task"
                                icon="fa-level-up"
                                invisible="hide_button == True"
                                confirm="Convert this checklist item into a sub-task?"
                            />
                            <field name="reviewer_id" optional="hide" />
                            <field name="deadline" optional="hide" />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_task_kanban">
        <field name="name">project.task.kanban@project_task_subtask</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="kanban_subtasks_progress_bar" invisible="1" />
                <field name="kanban_subtasks_progress_list" invisible="1" />
            </xpath>
            <xpath expr="//footer" position="before">
                <div>
                    <t t-out="record.kanban_subtasks_progress_bar.raw_value" />
                    <t t-out="record.kanban_subtasks_progress_list.raw_value" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
