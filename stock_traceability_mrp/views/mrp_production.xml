<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="mrp_production_form_view">
        <field name="name">mrp.production.form@stock_traceability_mrp</field>
        <field name="model">mrp.production</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']/list" position="inside">
                <field
                    name="mrp_status"
                    string="Procurement Status"
                    class="d_move_procurement_status"
                />
                <button
                    name="action_view_created_item"
                    title="Open"
                    type="object"
                    invisible="not action_view_created_item_visible"
                    icon="fa-external-link"
                />
            </xpath>
        </field>
    </record>
</odoo>
